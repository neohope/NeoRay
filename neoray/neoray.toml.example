# NeoRay 配置示例

[app]
name = "NeoRay AI Assistant"
version = "0.1.0"
env = "development"

[server]
host = "127.0.0.1"
port = 8080
read_timeout = 60
write_timeout = 60
idle_timeout = 120
# 单条 WebSocket 消息的处理超时。默认 10m。
# 必须大于 agent 内部处理超时（5m），否则多轮工具调用的长任务会被提前截断。
ws_message_timeout = "10m"

[llm]
default_provider = "anthropic"

# 主提供商配置 (Anthropic)
[llm.providers.anthropic]
api_key = "sk-ant-..."
api_url = "https://api.anthropic.com"
model = "claude-3-opus-20240229"
max_tokens = 4096
temperature = 0.7
timeout = 60
reasoning_effort = "medium"  # 可选: low, medium, high, adaptive, none
prompt_cache_enabled = true  # 启用提示缓存

# 备用提供商 1 (OpenAI)
[llm.providers.openai]
api_key = "sk-..."
api_url = "https://api.openai.com/v1"
model = "gpt-4"
max_tokens = 4096
temperature = 0.7
timeout = 60

# 备用提供商 2 (DeepSeek)
[llm.providers.deepseek]
api_key = "sk-..."
api_url = "https://api.deepseek.com/v1"
model = "deepseek-chat"
max_tokens = 4096
temperature = 0.7
timeout = 60

# Fallback 模型配置 - 当主提供商失败时会依次尝试这些
[[llm.fallback_models]]
model = "gpt-4"
provider = "openai"
max_tokens = 4096
temperature = 0.7
reasoning_effort = "none"

[[llm.fallback_models]]
model = "deepseek-chat"
provider = "deepseek"
max_tokens = 4096
temperature = 0.7

[memory]
workspace = "~/.neoray/workspace"
git_enabled = true
dream_interval = "2h"
session_ttl_minutes = 1440
max_history_entries = 1000

[session]
[session.storage]
type = "file"
max_sessions = 100
max_messages_per_session = 1000

[agent]
# 单次工具调用的外层超时；0 = 按内层工具超时自动推算（推荐）
# 若某些工具本身配置了更长超时（如 tools.shell.timeout = 120s），
# 这里配成固定小值会让它们被提前掐断。
tool_timeout = 0
# 单条消息整轮处理超时（含多轮工具调用）；0 = 默认 10 分钟
message_timeout = 0
# 单个工具结果进入上下文前的字符上限；0 = 默认 16000
# 防止 cat/grep 这类命令的大输出把下一轮请求撑爆
max_tool_result_chars = 16000

[tools]
[tools.workspace]
enabled = true
# security.restrict_to_workspace = true 时，shell 命令里的路径必须落在
# workspace 或下面这些目录内；不在列表里的绝对路径会被拒绝。
# 支持 ~ 前缀，可写多个目录。
allowed_paths = ["~/.neoray/workspace"]
read_only = false

[tools.filesystem]
enabled = true
max_file_size = 10485760
allowed_extensions = [".txt", ".md", ".json", ".yaml", ".yml", ".toml", ".go", ".py", ".js", ".ts", ".html", ".css"]
blocked_extensions = [".exe", ".dll", ".so", ".dylib", ".bin"]

[tools.shell]
enabled = true
timeout = 30
blocked_commands = ["rm -rf", "mkfs", "dd"]
working_dir = "~/.neoray/workspace"

[tools.web]
enabled = true
timeout = 30
max_content_length = 10485760
blocked_domains = ["malicious.example.com"]

[tools.cron]
enabled = true
max_jobs = 10

[skills]
enabled = true
builtin_skills_dir = "skills"
disabled_skills = []
auto_load_always = true

[channels]
[channels.feishu]
enabled = false
app_id = "cli_..."
app_secret = "..."
domain = "feishu.cn"
group_policy = "mention"
reply_to_message = true
topic_isolation = true
react_emoji = "THINKING"
done_emoji = "OK"
tool_hint_prefix = "🔧"
streaming = true

[security]
[security.auth]
enabled = true
# IMPORTANT: Generate a strong random secret before deploying!
# Example: openssl rand -hex 32
secret_key = ""
jwt_expiry = 86400

[security.rate_limit]
enabled = false
requests_per_minute = 60
burst = 10

["text/plain", "application/json", "text/markdown"]
temp_dir = "~/.neoray/tmp"

[logger]
level = "debug"
format = "text"
output = ["stdout", "file"]

[logger.file]
path = "~/.neoray/logs/neoray.log"
max_size = 100
max_backups = 5
max_age = 30
compress = true
rotate_daily = true

[database.sqlite]
path = "~/.neoray/data/neoray.db"

[database.postgres]
host = "localhost"
port = 5432
user = "neoray"
# IMPORTANT: Change this before deploying!
password = ""
dbname = "neoray"
sslmode = "disable"

[web]
# Web UI 开关。启用后可通过浏览器访问 http://<host>:<port>/ 使用聊天界面。
# 仅在浏览器访问时需要；CLI / Flutter 客户端 / 飞书渠道不受影响。
# 注意：Web UI 面向本机使用，建议保持 server.host = "127.0.0.1"。
enabled = false
# 静态资源目录。留空表示使用编译进二进制的内嵌资源（推荐，免安装）。
# 仅在本地调试前端时指向磁盘目录（如 "../webui/dist"），改前端无需重新编译。
static_dir = ""
# SPA 入口文件，留空使用默认 index.html。
# 开发模式下前端 dev server 的 Origin（如 "http://127.0.0.1:5173"），
# 非空时会加入 CORS 白名单，仅用于本地调试。
dev_origin = ""
